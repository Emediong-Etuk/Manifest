  "dependencies": {
    "@manifest/sdk": "workspace:*",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@sqds/multisig": "2.1.4",
    "bn.js": "5.2.2",
    "bs58": "6.0.0",
    "dotenv": "18.0.5",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15"
  }

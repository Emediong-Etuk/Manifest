{
  "name": "@manifest/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Manifest program: PDAs, account fetchers, instruction builders, status and formatting helpers",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "vitest": "5.0.3"
  }
}

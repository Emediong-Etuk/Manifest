{
  "name": "@manifest/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Manifest program: PDAs, account fetchers, instruction builders, status and formatting helpers",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "22.20.5",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.2",
    "canonicalize": "5.1.0"
  }
}

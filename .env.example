# Manifest environment variables.
# Copy to .env.local (gitignored) and fill in. Never commit real values.
# `pnpm check-env` reports which ones are set without printing them.

# --- Public (shipped to the browser) ---------------------------------------
# Cluster the app and scripts talk to: devnet | localnet | mainnet-beta. Devnet only for the hackathon.
NEXT_PUBLIC_CLUSTER=devnet
# Public URL of the app, no trailing slash (http://localhost:3000 locally, the Vercel URL in prod).
NEXT_PUBLIC_APP_URL=
# Helius devnet RPC URL (https://devnet.helius-rpc.com/?api-key=...). Falls back to the public devnet RPC if empty.
NEXT_PUBLIC_RPC_URL=
# Deployed Manifest program ID (set after the Phase 2 devnet deploy; must match Anchor.toml).
NEXT_PUBLIC_PROGRAM_ID=
# Phantom Portal App ID (phantom.com/portal). Needed for Google/Apple embedded wallets.
NEXT_PUBLIC_PHANTOM_APP_ID=
# 6-decimal "Manifest Demo Dollar" (mUSD) mint created by scripts/create-demo-mint.ts.
NEXT_PUBLIC_DEMO_MINT=
# Circle devnet USDC mint. Source: https://developers.circle.com/stablecoins/usdc-contract-addresses
# (Solana Devnet row; verified on devnet Oct 4, 2026: SPL Token, 6 decimals).
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Squads v4 vault PDA (index 0) acting as arbitrator and treasury owner (printed by scripts/squads-setup.ts).
NEXT_PUBLIC_SQUADS_VAULT=

# --- Server only -----------------------------------------------------------
# Pinata JWT for IPFS evidence uploads. If empty, evidence is stored on the local filesystem (.data/).
PINATA_JWT=
# Pinata dedicated gateway domain (e.g. example.mypinata.cloud).
PINATA_GATEWAY=
# Devnet-only keypair (base58 or JSON byte array) funding the faucet / gas tank; also demo mint authority.
GAS_TANK_SECRET_KEY=
# Devnet keypair the crank uses to pay for permissionless auto_approve / close_booking transactions.
CRANK_SECRET_KEY=
# Shared secret Vercel Cron sends to /api/cron/crank (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
# Scripts only: deploy/admin keypair file (default ~/.config/solana/manifest-dev.json).
MANIFEST_DEV_KEYPAIR_PATH=
# Scripts only: RPC override (falls back to NEXT_PUBLIC_RPC_URL, then the public cluster RPC).
RPC_URL=
# Optional Vercel KV / Upstash Redis for faucet rate limits. In-memory fallback if empty.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Local development only (never deployed) ---------------------------------
# Legacy Colosseum Copilot v1 token. Copilot v2 uses `npx @colosseum-org/copilot-connect login` instead; leave empty.
COLOSSEUM_COPILOT_PAT=
